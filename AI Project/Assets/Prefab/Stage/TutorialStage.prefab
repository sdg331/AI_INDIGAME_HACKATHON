  m_Script: {fileID: 11500000, guid: f822172624ed4f84ca687db93ecef445, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDirector
  steps:
  - title: "1. \uC774\uB3D9"
    kind: 0
    prompt: "A   D \u2014 \uC774\uB3D9"
    description: "\uC88C\uC6B0\uB85C \uC6C0\uC9C1\uC5EC \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uB77C."
    clearedMessage: "\uC88B\uB2E4."
  - title: "2. \uAD6C\uB974\uAE30"
    kind: 1
    prompt: "Shift \u2014 \uAD6C\uB974\uAE30"
    description: "\uAD6C\uB974\uB294 \uB3D9\uC548\uC5D0\uB294 \uACF5\uACA9\uC744
      \uB9DE\uC9C0 \uC54A\uB294\uB2E4."
    clearedMessage: "\uAD6C\uB974\uAE30 \uC2B5\uB4DD."
  - title: "3. \uC810\uD504"
    kind: 2
    prompt: "Space \u2014 \uC810\uD504"
    description: "\uBB34\uB108\uC9C4 \uB3CC\uB354\uBBF8\uB97C \uB6F0\uC5B4\uB118\uC5B4\uB77C."
    clearedMessage: "\uC810\uD504 \uC2B5\uB4DD."
  - title: "4. \uC5F0\uACA9\uACFC \uC2A4\uD0AC"
    kind: 3
    prompt: "\uC88C\uD074\uB9AD \u2014 \uACF5\uACA9"
    description: "\uC801\uC744 \uC5F0\uC18D\uC73C\uB85C \uBCA0\uC5B4 \uC5F0\uACA9\uC744
      \uC313\uC544\uB77C."
    clearedMessage: "\uCC38\uACA9 \uD30C\uB3D9\uC744 \uC775\uD614\uB2E4."
  - title: "5. \uD328\uB9C1"
    kind: 4
    prompt: "\uC6B0\uD074\uB9AD \u2014 \uBC29\uC5B4 \xB7 \uD328\uB9C1"
    description: "\uC801\uC774 \uD718\uB450\uB974\uB294 \uC21C\uAC04\uC5D0 \uB9DE\uCDB0
      \uC6B0\uD074\uB9AD. \uC644\uBCBD\uD558\uAC8C \uB9C9\uC73C\uBA74 \uC801\uC774
      \uBB34\uB108\uC9C4\uB2E4."
    clearedMessage: "\uD328\uB9C1 \uC131\uACF5."
  requiredCombo: 5
  practiceEnemy: {fileID: 0}
  hud: {fileID: 0}
  suspendOathDuringTutorial: 1
  onTutorialCompleted:
    m_PersistentCalls:
      m_Calls: []
