  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneController
  shots:
  - title: "1\uCEF7\uC52C"
    image: {fileID: 21300000, guid: b2741038630df1e41a2a04a1f9cc309a, type: 3}
    lines:
    - speaker: 
      text: "(\uB2EC\uB824\uAC00\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4)"
      kind: 0
  - title: "2\uCEF7\uC52C"
    image: {fileID: 21300000, guid: c045e9646602f8742ac4ef3db2a0eda5, type: 3}
    lines:
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uB3C4\uC2DC\uAC00 \uACF5\uACA9 \uBC1B\uACE0 \uC788\uC5B4...!"
      kind: 0
  - title: "3\uCEF7\uC52C"
    image: {fileID: 21300000, guid: 22af6a73856ec224a9f59e2497d6e531, type: 3}
    lines:
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uC544\uC9C1 \uAC80\uACFC \uACC4\uC57D\uC744 \uB9FA\uC9C0 \uC54A\uC558\uC9C0\uB9CC..."
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uADF8\uB798\uB3C4 \uD55C\uBA85\uC774\uB77C\uB3C4 \uB354 \uC0AC\uB78C\uB4E4\uC744
        \uAD6C\uD574\uC57C\uD574"
      kind: 0
  - title: "4\uCEF7\uC52C"
    image: {fileID: 21300000, guid: b5cb2813f0dd71a419fdb7e742b76e4b, type: 3}
    lines:
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uC5BC\uB9C8\uCBE4 \uB2EC\uB838\uC744\uAE4C \uAE30\uC5B5\uC774 \uB098\uC9C0
        \uC54A\uB294\uB2E4."
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uC8FC\uBCC0\uC5D0 \uB9C8\uBB3C\uC758 \uC6B8\uC74C\uC18C\uB9AC\uAC00
        \uB4E4\uB9AC\uC9C0\uB9CC"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uADF8\uB798\uB3C4 \uB6F0\uC5B4\uAC00\uC57C\uD55C\uB2E4."
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uADF8\uAC8C \uAE30\uC0AC\uB2C8\uAE50"
      kind: 0
  - title: "5\uCEF7\uC52C"
    image: {fileID: 21300000, guid: f3594af83c9299846853fa4e13c5ba4a, type: 3}
    lines:
    - speaker: "\uAE30\uC0AC"
      text: "\uC5B4..\uB51C\uAC00\uB294\uAC70\uB0D0"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uAE30\uC0AC\uB2E4"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uC62C\uACE7\uC740 \uB208\uC5D0 \uAE30\uC0AC\uB2E8\uC758 \uC0C1\uC9D5
        \uAC19\uC740 \uB9DD\uD1A0"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uAE30\uC0AC\uB2E4"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uC800\uB294 \uC0AC\uB78C\uB4E4\uC744 \uAD6C\uD558\uB7EC \uAC08\uAC81\uB2C8\uB2E4."
      kind: 0
    - speaker: "\uAE30\uC0AC"
      text: "\uD558\uD558\uD558"
      kind: 0
    - speaker: "\uAE30\uC0AC"
      text: "\uCE7C\uB3C4 \uC5C6\uB294 \uACAC\uC2B5\uAE30\uC0AC\uAC00 \uB9C8\uBB3C\uB4E4\uACFC
        \uC2F8\uC6B0\uACA0\uB2E8 \uB9D0\uC774\uB0D0"
      kind: 0
    - speaker: "\uC8FC\uC778\uACF5"
      text: "\uADF8\uB798\uB3C4 \uC2F8\uC6B8\uAC81\uB2C8\uB2E4."
      kind: 0
    - speaker: "\uAE30\uC0AC"
      text: "\uADF8\uB798 \uC62C\uACE7\uC740 \uB208\uC774\uAD6C\uB098 \uB108\uB294
        \uB0B4\uCE7C\uACFC\uC758 \uB9F9\uC138\uB97C \uD560 \uC790\uACA9\uC774 \uC788\uC5B4"
      kind: 0
  - title: "6\uCEF7\uC52C"
    image: {fileID: 21300000, guid: 3bc63fee8f5f7f34f95176941f233cee, type: 3}
    lines:
    - speaker: "\uAE30\uC0AC"
